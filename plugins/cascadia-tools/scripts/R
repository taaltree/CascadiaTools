#!/bin/bash
# Run interactive R for CascadiaTools. See _find_r.sh for how R is found (R >= 4.5).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CASCADIATOOLS_ROOT="${CASCADIATOOLS_ROOT:-${ECOTOOLS_ROOT:-$here}}"
source "$(dirname "${BASH_SOURCE[0]}")/_find_r.sh"
find_r R
if [[ -z "$R_BIN" ]]; then echo "R not found: install R 4.5+ from https://cran.r-project.org, or set CASCADIATOOLS_R to its folder" >&2; exit 127; fi
[[ -d "$CASCADIATOOLS_ROOT/Rlib" ]] && export R_LIBS_USER="$CASCADIATOOLS_ROOT/Rlib"
exec "$R_BIN" "$@"
